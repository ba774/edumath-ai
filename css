*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Arial,sans-serif;
background:#f5f7fb;
color:#222;
line-height:1.6;
}

.navbar{
position:sticky;
top:0;
z-index:1000;
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 40px;
background:white;
box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.logo{
font-size:1.6rem;
font-weight:bold;
color:#5b4bff;
}

.nav-links{
display:flex;
gap:30px;
}

.nav-links a{
text-decoration:none;
color:#222;
font-weight:bold;
}

.nav-links a:hover{
color:#5b4bff;
}

.hero{
background:linear-gradient(135deg,#5b4bff,#7f6dff);
padding:80px 20px;
text-align:center;
color:white;
}

.hero img{
max-width:220px;
width:80%;
margin-bottom:30px;
}

.hero h1{
font-size:3rem;
max-width:1000px;
margin:auto;
margin-bottom:25px;
}

.hero p{
max-width:800px;
margin:auto;
font-size:1.2rem;
margin-bottom:35px;
}

.button,
.btn{
display:inline-block;
padding:16px 32px;
background:white;
color:#5b4bff;
font-weight:bold;
text-decoration:none;
border-radius:12px;
}

.audiences{
padding:100px 20px;
}

.audiences h2{
text-align:center;
font-size:2.8rem;
margin-bottom:50px;
}

.audience-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;
max-width:1400px;
margin:auto;
}

.card{
background:white;
border-radius:20px;
overflow:hidden;
box-shadow:0 8px 25px rgba(0,0,0,.08);
}

.card img{
width:100%;
height:250px;
object-fit:cover;
}

.card h3{
padding:20px 20px 10px;
}

.card p{
padding:0 20px 20px;
color:#555;
}

.features{
padding:100px 20px;
max-width:1400px;
margin:auto;
}

.features h2{
text-align:center;
font-size:2.8rem;
margin-bottom:50px;
}

.feature-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
}

.feature-link{
text-decoration:none;
color:inherit;
}

.feature{
background:white;
padding:35px;
border-radius:20px;
box-shadow:0 5px 20px rgba(0,0,0,.08);
text-align:center;
transition:0.2s;
}

.feature:hover{
transform:translateY(-5px);
}

.feature h3{
margin-bottom:15px;
}

.cta{
background:linear-gradient(135deg,#5b4bff,#7f6dff);
padding:100px 20px;
text-align:center;
color:white;
}

.cta h2{
font-size:2.8rem;
margin-bottom:20px;
}

.cta p{
max-width:700px;
margin:auto;
margin-bottom:35px;
}

.contact{
background:#111827;
color:white;
padding:80px 20px;
text-align:center;
}

.contact h2{
margin-bottom:20px;
font-size:2.5rem;
}

footer{
background:black;
color:white;
text-align:center;
padding:25px;
}

@media(max-width:768px){

.navbar{
flex-direction:column;
gap:15px;
padding:20px;
}

.nav-links{
flex-wrap:wrap;
justify-content:center;
gap:15px;
}

.hero h1{
font-size:2rem;
}

.audiences h2,
.features h2,
.cta h2{
font-size:2rem;
}

}
